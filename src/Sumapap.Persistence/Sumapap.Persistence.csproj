<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AssemblyVersion>2.0.1</AssemblyVersion>
    <FileVersion>2.0.1.0524</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
  </PropertyGroup>

  <!--NuGet properties-->
  <PropertyGroup>
    <Title>Sumapap.Persistence</Title>
    <PackageId>Sumapap.Persistence</PackageId>
    <PackageTags>Sumapap;Persistence</PackageTags>
    <Description>
      The `Sumapap.Persistence` package provides a set of tools and abstractions for implementing persistence in your applications. It includes features such as caching, database access, and integration with dependency injection frameworks. With Sumapap.Persistence, you can easily manage your application's data storage and retrieval while maintaining a clean and modular architecture.
    </Description>
    <PackageReadmeFile>docs\Sumapap.Persistence.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\Sumapap.Persistence.md" Pack="true" PackagePath="docs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sumapap.DependencyInjection\Sumapap.DependencyInjection.csproj" />
    <ProjectReference Include="..\Sumapap.Persistence.Abstractions\Sumapap.Persistence.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sumapap.Persistence.Caching" />
    <InternalsVisibleTo Include="Sumapap.Persistence.Caching.FusionCache" />
    <InternalsVisibleTo Include="Sumapap.Persistence.EfCore" />
  </ItemGroup>

</Project>
