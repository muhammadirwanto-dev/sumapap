<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0524</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
  </PropertyGroup>

  <!--NuGet properties-->
  <PropertyGroup>
    <Title>Sumapap.Queries.Abstractions</Title>
    <PackageId>Sumapap.Queries.Abstractions</PackageId>
    <PackageTags>Sumapap;Queries;Abstractions</PackageTags>
    <Description>
      Utility for building dynamic queries, filtering, and sorting logic within the persistence layer.
    </Description>
    <PackageReadmeFile>docs\Sumapap.Queries.Abstractions.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\Sumapap.Queries.Abstractions.md" Pack="true" PackagePath="docs" />
  </ItemGroup>

</Project>
