<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0513</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
  </PropertyGroup>

  <!--NuGet properties-->
  <PropertyGroup>
    <Title>Sumapap.Caching</Title>
    <PackageId>Sumapap.Caching</PackageId>
    <PackageTags>Sumapap;Caching;Cache;KeyProvider</PackageTags>
    <Description>
      Provider-agnostic cache key generation abstractions for Sumapap packages.
    </Description>
    <PackageReadmeFile>docs\Sumapap.Caching.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\Sumapap.Caching.md" Pack="true" PackagePath="docs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sumapap.Common\Sumapap.Common.csproj" />
    <ProjectReference Include="..\Sumapap.DependencyInjection\Sumapap.DependencyInjection.csproj" />
  </ItemGroup>

</Project>
