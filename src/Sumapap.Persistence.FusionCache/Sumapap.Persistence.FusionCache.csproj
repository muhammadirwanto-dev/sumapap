<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0510</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
  </PropertyGroup>

  <!--NuGet properties-->
  <PropertyGroup>
    <Title>Sumapap.Persistence.Caching</Title>
    <PackageId>Sumapap.Persistence.Caching</PackageId>
    <PackageTags>Sumapap;Persistence;Caching</PackageTags>
    <Description>
      `Sumapap.Persistence.Caching` is a C# .NET library providing core abstractions and building blocks for the data persistence layer with caching capabilities.
      It facilitates the implementation of patterns like Repository and Unit of Work.
    </Description>
    <PackageReadmeFile>docs\Sumapap.Persistence.Caching.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sumapap.Caching\Sumapap.Caching.csproj" />
    <ProjectReference Include="..\Sumapap.Persistence.DependencyInjection\Sumapap.Persistence.DependencyInjection.csproj" />
    <ProjectReference Include="..\Sumapap.Persistence\Sumapap.Persistence.csproj" />
  </ItemGroup>
  
</Project>
