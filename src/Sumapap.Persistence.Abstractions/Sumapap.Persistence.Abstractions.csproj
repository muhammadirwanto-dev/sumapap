<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0.0524</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
  </PropertyGroup>

  <!--NuGet properties-->
  <PropertyGroup>
    <Title>Sumapap.Persistence.Domain</Title>
    <PackageId>Sumapap.Persistence.Domain</PackageId>
    <PackageTags>Sumapap;Persistence</PackageTags>
    <Description>
      `Sumapap.Persistence.Domain` is a C# .NET library providing core abstractions and building blocks for the data persistence layer.
      It facilitates the implementation of patterns like Repository and Unit of Work.
    </Description>
    <PackageReadmeFile>docs\Sumapap.Persistence.Abstractions.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\Sumapap.Persistence.Abstractions.md" Pack="true" PackagePath="docs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sumapap.Queries\Sumapap.Queries.csproj" />
  </ItemGroup>

</Project>
