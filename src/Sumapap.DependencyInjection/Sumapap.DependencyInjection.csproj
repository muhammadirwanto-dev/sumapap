<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0914</FileVersion>
    <VersionPrefix>$(AssemblyVersion)</VersionPrefix>
  </PropertyGroup>

  <!--NuGet properties-->
  <PropertyGroup>
    <Title>Sumapap.DependencyInjection</Title>
    <PackageId>Sumapap.DependencyInjection</PackageId>
    <PackageTags>Sumapap;DependencyInjection;DI;Builder;Configuration</PackageTags>
    <Description>Fluent builder pattern for configuring Sumapap services with dependency injection. Provides ISumapapBuilder for registering repositories, domain services, and other Sumapap components.</Description>
    <PackageReadmeFile>docs\Sumapap.DependencyInjection.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\Sumapap.DependencyInjection.md" Pack="true" PackagePath="docs" />
  </ItemGroup>

<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sumapap.Caching" />
    <InternalsVisibleTo Include="Sumapap.Ddd" />
    <InternalsVisibleTo Include="Sumapap.Ddd.Abstractions" />
    <InternalsVisibleTo Include="Sumapap.Ddd.Mediator" />
    <InternalsVisibleTo Include="Sumapap.Navigations" />
    <InternalsVisibleTo Include="Sumapap.Navigations.Maui" />
    <InternalsVisibleTo Include="Sumapap.Persistence" />
    <InternalsVisibleTo Include="Sumapap.Persistence.Caching" />
    <InternalsVisibleTo Include="Sumapap.Persistence.Caching.FusionCache" />
    <InternalsVisibleTo Include="Sumapap.Persistence.DependencyInjection" />
    <InternalsVisibleTo Include="Sumapap.Persistence.EfCore" />
    <InternalsVisibleTo Include="Sumapap.Reporting" />
    <InternalsVisibleTo Include="Sumapap.Reporting.Maui" />
    <InternalsVisibleTo Include="Sumapap.Tests" />
  </ItemGroup>
  
</Project>
